---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { topicIndex, topicHref } from '../../lib/topics';
import { pageGraph, webPage, siteUrl } from '../../lib/seo';

const topics = topicIndex();
const description = 'Browse hideouts apps and research by topic, from the topics each repository lists on GitHub.';
const jsonLd = pageGraph(
  webPage({
    type: 'CollectionPage',
    name: 'Topics',
    path: '/topics/',
    description,
    extra: {
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: topics.length,
        itemListElement: topics.map((t, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: siteUrl(topicHref(t.topic)),
          name: t.topic,
        })),
      },
    },
  }),
  [{ name: 'Topics', path: '/topics/' }],
);
---

<Base title="Topics" description={description} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Topics"
    title="Browse by topic"
    lead="Topics come from each repository on GitHub. Only topics shared by more than one project are listed here."
  />
  <section class="container-x pt-10" aria-label="All topics">
    <ul class="flex flex-wrap gap-2">
      {topics.map(({ topic, projects }) => (
        <li>
          <a href={topicHref(topic)} class="chip font-mono text-sm hover:border-line-strong hover:text-ink">
            {topic}
            <span class="text-ink-3">{projects.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
