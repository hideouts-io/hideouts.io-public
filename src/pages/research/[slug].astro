---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Platforms from '../../components/Platforms.astro';
import ReadmeBody from '../../components/ReadmeBody.astro';
import KeyFindings from '../../components/KeyFindings.astro';
import CiteThis from '../../components/CiteThis.astro';
import { linkedTopics, topicHref } from '../../lib/topics';
import ResearchCard from '../../components/ResearchCard.astro';
import { researchEntries, fmtDate, type Entry } from '../../lib/content';
import { siteUrl, breadcrumbs, organization } from '../../lib/seo';

export function getStaticPaths() {
  return researchEntries().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry: e } = Astro.props as { entry: Entry };
const gh = e.gh;
// Only claim the observation/interpretation split where the write-up actually makes it.
const evidenceFirst = /panel-(evidence|interpret)|direct observation/i.test(gh.html);
const all = researchEntries();
const more = all.filter((r) => r.slug !== e.slug).slice(0, 3);
const index = all.findIndex((r) => r.slug === e.slug);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
// Topics come from the repository's GitHub topics; show the first few.
const TOPIC_LIMIT = 8;
const withPages = linkedTopics();
// Topics with a page first, so the links make the cut.
const topics = [...gh.topics].sort((a, b) => Number(withPages.has(b)) - Number(withPages.has(a))).slice(0, TOPIC_LIMIT);
const moreTopics = gh.topics.length - topics.length;
// Opens the shared "Research correction" issue form from hideouts-io/.github.
const correctionUrl = `${gh.htmlUrl}/issues/new?template=research_correction.yml`;

const article = {
  '@type': 'TechArticle',
  headline: e.name,
  description: e.summary,
  ...(e.findings?.length ? { abstract: e.findings.map((f) => f.replace(/`/g, '')).join(' ') } : {}),
  url: new URL(e.href, 'https://hideouts.io').toString(),
  image: new URL(`/og/${e.slug}.png`, 'https://hideouts.io').toString(),
  datePublished: gh.createdAt,
  dateModified: gh.updatedAt,
  author: { '@id': siteUrl('/#organization') },
  publisher: { '@id': siteUrl('/#organization') },
  about: e.platforms.map((p) => ({ '@type': 'Thing', name: p })),
  keywords: gh.topics.join(', ') || undefined,
  isBasedOn: gh.htmlUrl,
  ...(gh.license ? { license: `https://spdx.org/licenses/${gh.license}.html` } : {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    article,
    breadcrumbs([
      { name: 'Research', path: '/research/' },
      { name: e.name, path: e.href },
    ]),
  ],
};
---

<Base
  title={e.name}
  description={e.summary}
  image={`/og/${e.slug}.png`}
  imageAlt={`${e.name}: ${e.tagline}`}
  type="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta name="citation_title" content={e.name} />
    <meta name="citation_author" content="hideouts" />
    <meta name="citation_publication_date" content={gh.createdAt.slice(0, 10).replace(/-/g, '/')} />
    <meta name="citation_online_date" content={gh.updatedAt.slice(0, 10).replace(/-/g, '/')} />
    <meta name="citation_public_url" content={siteUrl(e.href)} />
    <meta property="article:published_time" content={gh.createdAt} />
    <meta property="article:modified_time" content={gh.updatedAt} />
  </Fragment>
  <header class="relative overflow-hidden border-b border-line">
    <div class="hero-bg"></div>
    <div class="container-x relative pt-8 pb-14">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-3">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/research/" class="hover:text-ink">
              Research
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="truncate text-ink-2">
            {e.name}
          </li>
        </ol>
      </nav>

      <div class="mt-10 max-w-3xl">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ink-3">
          <Platforms platforms={e.platforms} />
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" size={14} />
            {gh.readingMinutes} min read
          </span>
          <span aria-hidden="true">·</span>
          <span>
            Published <time datetime={gh.createdAt}>{fmtDate(gh.createdAt)}</time>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            Updated <time datetime={gh.updatedAt}>{fmtDate(gh.updatedAt)}</time>
          </span>
        </div>
        <h1 class="mt-5 text-3xl leading-tight font-semibold tracking-[-0.025em] text-balance text-ink sm:text-5xl sm:leading-[1.1]">
          {e.name}
        </h1>
        <p class="mt-5 text-xl leading-8 text-pretty text-ink-2">{e.tagline}</p>
        <p class="mt-4 leading-7 text-pretty text-ink-2">{e.summary}</p>
        {topics.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Topics">
            {topics.map((t) =>
              withPages.has(t) ? (
                <li>
                  <a href={topicHref(t)} class="chip font-mono hover:border-line-strong hover:text-ink">
                    {t}
                  </a>
                </li>
              ) : (
                <li class="chip font-mono">{t}</li>
              ),
            )}
            {moreTopics > 0 && <li class="chip">+{moreTopics} more</li>}
          </ul>
        )}
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={gh.htmlUrl} class="btn btn-ghost" rel="noopener noreferrer">
            <Icon name="github" size={16} /> Evidence &amp; source files
          </a>
          {gh.homepage && (
            <a href={gh.homepage} class="btn btn-ghost" rel="noopener noreferrer">
              <Icon name="doc" size={16} /> Research site
            </a>
          )}
          {gh.license && (
            <span class="chip self-center">
              <Icon name="scale" size={12} />
              {gh.license}
            </span>
          )}
        </div>
      </div>
    </div>
  </header>

  <section class="container-x pt-12">
    <ReadmeBody gh={gh} title={e.name} kind="Research" deep>
      {e.findings?.length ? <KeyFindings findings={e.findings} bottomLine={e.bottomLine} jumpTo={e.jumpTo} /> : null}
      {evidenceFirst && (
        <aside class="callout callout-note mb-10 max-w-[48rem]">
          <p class="callout-title">How to read this</p>
          <p>
            {'This write-up separates '}
            <strong>direct observation</strong>
            {' (what the artifacts show) from '}
            <strong>interpretation</strong>
            {' (what it may mean). Raw evidence panels are marked, and the original files are in the '}
            <a class="text-accent underline underline-offset-2" href={gh.htmlUrl} rel="noopener noreferrer">
              GitHub repository
            </a>
            .
          </p>
        </aside>
      )}
      <footer slot="after" class="mt-16 max-w-[48rem] space-y-6 border-t border-line pt-8">
        {gh.readmeHistory?.length ? (
          <section class="card p-5" aria-labelledby="revision-history">
            <h2 id="revision-history" class="font-semibold text-ink">
              Revision history
            </h2>
            <p class="mt-1 text-sm text-ink-3">Recent changes to this write-up, from its repository.</p>
            <ol class="mt-3 divide-y divide-line text-sm">
              {gh.readmeHistory.map((r) => (
                <li class="flex flex-col gap-0.5 py-2.5 sm:flex-row sm:gap-4">
                  <time datetime={r.date} class="shrink-0 text-ink-3 tabular-nums sm:w-28">
                    {fmtDate(r.date)}
                  </time>
                  <a href={r.url} class="text-ink-2 hover:text-ink hover:underline" rel="noopener noreferrer">
                    {r.message}
                  </a>
                </li>
              ))}
            </ol>
            <a
              href={`${gh.htmlUrl}/commits/${gh.defaultBranch}/README.md`}
              class="mt-3 inline-block text-sm text-accent hover:underline"
              rel="noopener noreferrer"
            >
              Full history on GitHub
            </a>
          </section>
        ) : null}
        <CiteThis name={e.name} url={siteUrl(e.href)} repoUrl={gh.htmlUrl} slug={e.slug} updatedAt={gh.updatedAt} />
        <div class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-semibold text-ink">Found an error or have better evidence?</p>
            <p class="mt-1 text-sm leading-6 text-ink-2">
              Corrections are welcome. Point to the artifact, log line, or public source, and keep observation separate
              from interpretation.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2">
            <a href={correctionUrl} class="btn btn-primary" rel="noopener noreferrer">
              Suggest a correction
            </a>
            <a href={gh.htmlUrl} class="btn btn-ghost" rel="noopener noreferrer">
              <Icon name="github" size={16} /> Evidence
            </a>
          </div>
        </div>
        {(prev || next) && (
          <nav aria-label="More research" class="grid gap-3 sm:grid-cols-2">
            {prev ? (
              <a href={prev.href} class="card card-link group p-4" rel="prev">
                <span class="text-xs text-ink-3">
                  <span aria-hidden="true">← </span>Previous<span class="sr-only">: </span>
                </span>
                <span class="mt-1 block font-medium text-ink group-hover:text-accent">{prev.name}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.href} class="card card-link group p-4 text-right" rel="next">
                <span class="text-xs text-ink-3">
                  Next<span class="sr-only">: </span>
                  <span aria-hidden="true"> →</span>
                </span>
                <span class="mt-1 block font-medium text-ink group-hover:text-accent">{next.name}</span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </ReadmeBody>
  </section>

  <section class="container-x pt-24" aria-labelledby="more-heading">
    <h2 id="more-heading" class="text-lg font-semibold text-ink">
      More research
    </h2>
    <ul class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {more.map((m) => (
        <li>
          <ResearchCard entry={m} />
        </li>
      ))}
    </ul>
  </section>
</Base>
