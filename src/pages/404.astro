---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found" description="This page doesn’t exist.">
  <section class="relative overflow-hidden">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="container-x relative py-28 text-center sm:py-36">
      <p class="eyebrow">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Nothing hiding here.</h1>
      <p class="mx-auto mt-4 max-w-md text-ink-2">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Go home <Icon name="arrow-right" size={16} />
        </a>
        <button type="button" data-open-search class="btn btn-ghost">
          Search the site
        </button>
      </div>
    </div>
  </section>
</Base>
