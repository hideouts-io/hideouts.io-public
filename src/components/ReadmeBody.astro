---
/** Rendered README with a sticky table of contents (desktop) and a collapsible one (mobile). */
import type { Generated } from '../lib/content';
interface Props {
  gh: Generated;
  /** Title and section label for search results. */
  title: string;
  kind: 'App' | 'Research';
  /** Allow h3 entries in the TOC (research articles). */
  deep?: boolean;
}
const { gh, title, kind, deep = false } = Astro.props;
const toc = gh.toc.filter(
  (t) => t.depth === 2 || (deep && t.depth === 3 && gh.toc.filter((x) => x.depth === 2).length < 6),
);
const hasToc = toc.length > 2;
---

<div class="grid gap-12 lg:grid-cols-[15rem_minmax(0,1fr)]">
  {hasToc && (
    <nav class="toc hidden lg:block" aria-label="On this page">
      <div data-toc-scroll class="sticky top-24 max-h-[calc(100dvh-8rem)] overflow-y-auto pr-2">
        <p class="text-xs font-semibold tracking-wider text-ink-3 uppercase">On this page</p>
        <ul class="mt-3 space-y-0.5 border-l border-line text-sm">
          {toc.map((t) => (
            <li>
              <a
                href={`#${t.id}`}
                class:list={[
                  '-ml-px block border-l border-transparent py-1 leading-5 text-ink-2 hover:border-line-strong hover:text-ink',
                  t.depth === 3 ? 'pl-6 text-[0.8125rem]' : 'pl-3',
                ]}
              >
                {t.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )}
  <div class:list={['min-w-0', !hasToc && 'lg:col-span-2 mx-auto w-full max-w-3xl']}>
    {hasToc && (
      <details class="card mb-8 p-4 lg:hidden">
        <summary class="cursor-pointer text-sm font-medium text-ink">On this page</summary>
        <ul class="mt-3 space-y-1.5 text-sm">
          {toc.map((t) => (
            <li class:list={[t.depth === 3 && 'pl-4']}>
              <a href={`#${t.id}`} class="text-ink-2 hover:text-ink">
                {t.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <slot />
    <article
      class="prose-readme max-w-[48rem]"
      data-pagefind-body
      data-pagefind-meta={`title:${title}`}
      data-pagefind-filter={`kind:${kind}`}
      set:html={gh.html}
    />
    <slot name="after" />
  </div>
</div>
