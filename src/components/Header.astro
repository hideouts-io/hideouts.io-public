---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const nav = [
  { href: '/apps/', label: 'Apps' },
  { href: '/research/', label: 'Research' },
  { href: '/contribute/', label: 'Contribute' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-xl backdrop-saturate-150">
  <div class="container-x flex h-16 items-center gap-6">
    <a href="/" class="shrink-0 rounded-lg" aria-label="hideouts.io home">
      <Logo class="header-logo" />
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.9375rem]">
        {nav.map((n) => (
          <li>
            <a
              href={n.href}
              aria-current={isActive(n.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 transition-colors',
                isActive(n.href) ? 'bg-surface-2 text-ink' : 'text-ink-2 hover:text-ink',
              ]}
            >
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-open-search
        class="hidden h-9 items-center gap-2 rounded-full border border-line bg-surface px-3 text-sm text-ink-3 hover:border-line-strong hover:text-ink-2 lg:inline-flex"
        aria-label="Search"
      >
        <Icon name="search" size={15} />
        <span class="pr-6">Search</span>
        <kbd>⌘K</kbd>
      </button>
      <button
        type="button"
        data-open-search
        class="grid size-9 place-items-center rounded-full text-ink-2 hover:bg-surface-2 hover:text-ink lg:hidden"
        aria-label="Search"
      >
        <Icon name="search" size={18} />
      </button>
      <a
        href="https://github.com/hideouts-io"
        class="grid size-9 place-items-center rounded-full text-ink-2 hover:bg-surface-2 hover:text-ink"
        aria-label="hideouts-io on GitHub"
        rel="noopener noreferrer"
      >
        <Icon name="github" size={18} />
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full text-ink-2 hover:bg-surface-2 hover:text-ink"
        aria-label="Switch color theme"
      >
        <Icon name="sun" size={18} class="theme-icon-sun" />
        <Icon name="moon" size={18} class="theme-icon-moon" />
      </button>

      <details class="relative md:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-ink-2 hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" size={18} />
        </summary>
        <nav aria-label="Mobile" class="card absolute right-0 top-11 w-48 p-1.5">
          {nav.map((n) => (
            <a href={n.href} class="block rounded-lg px-3 py-2 text-ink-2 hover:bg-surface-2 hover:text-ink">
              {n.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<dialog class="search-dialog" data-search-dialog aria-label="Search hideouts.io">
  <form method="dialog" class="flex items-center gap-3 border-b border-line px-4" role="search" data-search-form>
    <Icon name="search" size={18} class="shrink-0 text-ink-3" />
    <input
      type="search"
      data-search-input
      placeholder="Search apps and research…"
      autocomplete="off"
      spellcheck="false"
      aria-label="Search"
      class="h-14 w-full bg-transparent text-base text-ink placeholder:text-ink-3 focus:outline-none"
    />
    <button type="button" data-close-search class="shrink-0">
      <kbd>esc</kbd>
    </button>
  </form>
  <div class="max-h-[60dvh] overflow-y-auto p-2">
    <p data-search-status aria-live="polite" class="px-3 py-6 text-center text-sm text-ink-3">
      Type to search every app and research write-up.
    </p>
    <ul id="search-results" data-search-results aria-label="Search results" class="space-y-1"></ul>
  </div>
</dialog>

<style>
  /* Show the icon for the theme you'd switch to: a sun while dark, a moon while light. */
  :global(.theme-icon-sun) {
    display: block;
  }
  :global(.theme-icon-moon) {
    display: none;
  }
  :global(:root[data-theme='light'] .theme-icon-sun) {
    display: none;
  }
  :global(:root[data-theme='light'] .theme-icon-moon) {
    display: block;
  }
</style>
