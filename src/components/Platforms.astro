---
import Icon from './Icon.astro';
import { OTHER_HOSTS, type Platform } from '../data/projects';
interface Props {
  platforms: Platform[];
  /** Cards: collapse Windows/Linux/ChromeOS into one "Cross-platform" chip. */
  compact?: boolean;
}
const { platforms, compact = false } = Astro.props;
const others = platforms.filter((p) => OTHER_HOSTS.includes(p));
const shown = compact ? platforms.filter((p) => !OTHER_HOSTS.includes(p)) : platforms;
---

{shown.map((p) =>
  p === 'iOS' ? (
    <span class="chip chip-ios">
      <Icon name="iphone" size={13} />
      iOS
    </span>
  ) : p === 'macOS' ? (
    <span class="chip chip-accent">
      <Icon name="mac" size={13} />
      macOS
    </span>
  ) : (
    <span class="chip">
      <Icon name="monitor" size={13} />
      {p}
    </span>
  ),
)}
{compact && others.length > 0 && (
  <span class="chip" title={`Also runs on ${others.join(', ')}`}>
    <Icon name="monitor" size={13} />
    Cross-platform
    <span class="sr-only">: also runs on {others.join(', ')}</span>
  </span>
)}
